[Unit]
Description=MBL Storage Node
Documentation=https://github.com/msorenss/mbl/blob/main/docs/book/src/distributed-workers.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Pair once:  sudo -u mbl mbl-node --config /var/lib/mbl-node/node.json pair --server ... --code ... --base-url ...
# Share:      sudo -u mbl mbl-node --config /var/lib/mbl-node/node.json library add --name Movies --kind movie --path /srv/movies
User=mbl
Group=mbl
StateDirectory=mbl-node
ExecStart=/usr/bin/mbl-node --config /var/lib/mbl-node/node.json run
Restart=on-failure
RestartSec=10s

# The node only reads media; it writes nothing but its own state.
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
