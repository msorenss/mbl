[Unit]
Description=MBL 10-foot TV Client (Appliance Mode)
After=network-online.target mbl.service
Wants=mbl.service

[Service]
Type=simple
User=mbl
Group=mbl
SupplementaryGroups=video render input audio plugdev
Environment=MBL_SERVER_URL=http://127.0.0.1:8420
ExecStart=/usr/bin/mbl-tv
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
