{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "MBL Design System Tokens (W3C Design Tokens Format, PLAN §10.2)",
  "color": {
    "theme": {
      "dark": {
        "bg-base": { "$type": "color", "$value": "#0c0e14", "$description": "Primary app background" },
        "bg-surface": { "$type": "color", "$value": "#141721", "$description": "Elevated surface (sidebar, header, sheets)" },
        "bg-surface-hover": { "$type": "color", "$value": "#1e2230", "$description": "Interactive surface hover state" },
        "bg-card": { "$type": "color", "$value": "#181b26", "$description": "Card and poster container background" },
        "bg-overlay": { "$type": "color", "$value": "#1e2333", "$description": "Modal and popover surface" },
        "text-primary": { "$type": "color", "$value": "#f8fafc", "$description": "Primary foreground text" },
        "text-secondary": { "$type": "color", "$value": "#94a3b8", "$description": "Secondary metadata text" },
        "text-muted": { "$type": "color", "$value": "#64748b", "$description": "Muted captions and placeholders" },
        "border": { "$type": "color", "$value": "#222738", "$description": "Subtle hairline border" }
      },
      "oled": {
        "bg-base": { "$type": "color", "$value": "#000000", "$description": "True pitch-black OLED background" },
        "bg-surface": { "$type": "color", "$value": "#08090d", "$description": "Near-black surface for OLED" },
        "bg-surface-hover": { "$type": "color", "$value": "#12151f", "$description": "OLED surface hover" },
        "bg-card": { "$type": "color", "$value": "#0b0d13", "$description": "OLED card background" },
        "bg-overlay": { "$type": "color", "$value": "#141824", "$description": "OLED overlay surface" },
        "text-primary": { "$type": "color", "$value": "#ffffff", "$description": "Crisp white foreground" },
        "text-secondary": { "$type": "color", "$value": "#a1a1aa", "$description": "Secondary OLED text" },
        "text-muted": { "$type": "color", "$value": "#71717a", "$description": "Muted OLED text" },
        "border": { "$type": "color", "$value": "#18181b", "$description": "Low-luminance OLED border" }
      },
      "light": {
        "bg-base": { "$type": "color", "$value": "#f8fafc", "$description": "Light mode base background" },
        "bg-surface": { "$type": "color", "$value": "#ffffff", "$description": "Light mode surface" },
        "bg-surface-hover": { "$type": "color", "$value": "#f1f5f9", "$description": "Light mode hover surface" },
        "bg-card": { "$type": "color", "$value": "#ffffff", "$description": "Light mode card background" },
        "bg-overlay": { "$type": "color", "$value": "#e2e8f0", "$description": "Light mode overlay" },
        "text-primary": { "$type": "color", "$value": "#0f172a", "$description": "Dark slate primary text" },
        "text-secondary": { "$type": "color", "$value": "#475569", "$description": "Secondary slate text" },
        "text-muted": { "$type": "color", "$value": "#64748b", "$description": "Muted slate text" },
        "border": { "$type": "color", "$value": "#e2e8f0", "$description": "Light mode border" }
      },
      "high-contrast": {
        "bg-base": { "$type": "color", "$value": "#000000", "$description": "High-contrast black background" },
        "bg-surface": { "$type": "color", "$value": "#0a0a0a", "$description": "High-contrast surface" },
        "bg-surface-hover": { "$type": "color", "$value": "#1f1f1f", "$description": "High-contrast hover" },
        "bg-card": { "$type": "color", "$value": "#0f0f0f", "$description": "High-contrast card" },
        "bg-overlay": { "$type": "color", "$value": "#1a1a1a", "$description": "High-contrast overlay" },
        "text-primary": { "$type": "color", "$value": "#ffffff", "$description": "Maximum contrast primary text" },
        "text-secondary": { "$type": "color", "$value": "#f4f4f5", "$description": "High-contrast secondary text" },
        "text-muted": { "$type": "color", "$value": "#d4d4d8", "$description": "High-contrast muted text" },
        "border": { "$type": "color", "$value": "#ffffff", "$description": "High-contrast white border" }
      }
    },
    "accent": {
      "amber": {
        "base": { "$type": "color", "$value": "#f59e0b", "$description": "Default warm amber accent (PLAN §10.2)" },
        "hover": { "$type": "color", "$value": "#d97706" },
        "light": { "$type": "color", "$value": "rgba(245, 158, 11, 0.16)" }
      },
      "indigo": {
        "base": { "$type": "color", "$value": "#6366f1" },
        "hover": { "$type": "color", "$value": "#4f46e5" },
        "light": { "$type": "color", "$value": "rgba(99, 102, 241, 0.16)" }
      },
      "emerald": {
        "base": { "$type": "color", "$value": "#10b981" },
        "hover": { "$type": "color", "$value": "#059669" },
        "light": { "$type": "color", "$value": "rgba(16, 185, 129, 0.16)" }
      },
      "rose": {
        "base": { "$type": "color", "$value": "#f43f5e" },
        "hover": { "$type": "color", "$value": "#e11d48" },
        "light": { "$type": "color", "$value": "rgba(244, 63, 94, 0.16)" }
      },
      "cyan": {
        "base": { "$type": "color", "$value": "#06b6d4" },
        "hover": { "$type": "color", "$value": "#0891b2" },
        "light": { "$type": "color", "$value": "rgba(6, 182, 212, 0.16)" }
      },
      "violet": {
        "base": { "$type": "color", "$value": "#8b5cf6" },
        "hover": { "$type": "color", "$value": "#7c3aed" },
        "light": { "$type": "color", "$value": "rgba(139, 92, 246, 0.16)" }
      }
    },
    "semantic": {
      "success": {
        "base": { "$type": "color", "$value": "#10b981" },
        "hover": { "$type": "color", "$value": "#059669" },
        "light": { "$type": "color", "$value": "rgba(16, 185, 129, 0.15)" }
      },
      "warning": {
        "base": { "$type": "color", "$value": "#f59e0b" },
        "hover": { "$type": "color", "$value": "#d97706" },
        "light": { "$type": "color", "$value": "rgba(245, 158, 11, 0.15)" }
      },
      "danger": {
        "base": { "$type": "color", "$value": "#ef4444" },
        "hover": { "$type": "color", "$value": "#dc2626" },
        "light": { "$type": "color", "$value": "rgba(239, 68, 68, 0.15)" }
      },
      "info": {
        "base": { "$type": "color", "$value": "#3b82f6" },
        "hover": { "$type": "color", "$value": "#2563eb" },
        "light": { "$type": "color", "$value": "rgba(59, 130, 246, 0.15)" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif"
      },
      "display": {
        "$type": "fontFamily",
        "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      }
    },
    "fontSize": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "13px" },
      "md": { "$type": "dimension", "$value": "15px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "22px" },
      "2xl": { "$type": "dimension", "$value": "28px" },
      "3xl": { "$type": "dimension", "$value": "36px" },
      "hero": { "$type": "dimension", "$value": "48px" },
      "tv-body": { "$type": "dimension", "$value": "24px" }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold": { "$type": "fontWeight", "$value": "700" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": "1.2" },
      "normal": { "$type": "number", "$value": "1.5" },
      "relaxed": { "$type": "number", "$value": "1.65" }
    }
  },
  "spacing": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "elevation": {
    "sm": { "$type": "shadow", "$value": "0 2px 6px -1px rgba(0, 0, 0, 0.4)" },
    "md": { "$type": "shadow", "$value": "0 6px 16px -4px rgba(0, 0, 0, 0.55)" },
    "lg": { "$type": "shadow", "$value": "0 12px 28px -6px rgba(0, 0, 0, 0.7)" },
    "xl": { "$type": "shadow", "$value": "0 20px 40px -10px rgba(0, 0, 0, 0.8)" },
    "focus-glow": { "$type": "shadow", "$value": "0 0 0 3px var(--accent-light)" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "normal": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "300ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "decelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0, 1)" },
      "accelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0.3, 0, 1, 1)" }
    }
  }
}
