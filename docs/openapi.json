{
  "openapi": "3.1.0",
  "info": {
    "title": "MBL API",
    "description": "MBL media server REST API.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in; returns a bearer token and sets the session cookie.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {},
          "429": {}
        },
        "security": []
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current session.",
        "operationId": "logout",
        "responses": {
          "204": {}
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The current user.",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The current user's sessions.",
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions/{id}": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke one of the current user's sessions.",
        "operationId": "revoke_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {}
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "WebSocket stream of `{type, data}` events the user may see.",
        "operationId": "events",
        "responses": {
          "101": {
            "description": "Switching to WebSocket"
          }
        }
      }
    },
    "/api/v1/hubs/home": {
      "get": {
        "tags": [
          "browse"
        ],
        "summary": "Home screen hubs: Continue Watching, Up Next, Recently Added per library.",
        "operationId": "home",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Hub"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/{id}": {
      "get": {
        "tags": [
          "images"
        ],
        "summary": "A resized JPEG of an artwork; `w` snaps to a fixed set of widths.",
        "operationId": "image",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "w",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "v",
            "in": "query",
            "description": "Content hash from the item DTO; when it matches, the response is cached as immutable.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/jpeg": {}
            }
          },
          "304": {},
          "404": {}
        }
      }
    },
    "/api/v1/items/{id}": {
      "get": {
        "tags": [
          "browse"
        ],
        "summary": "Item details with versions, streams, people, genres, artwork and watch state.",
        "operationId": "detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDetail"
                }
              }
            }
          },
          "404": {}
        }
      }
    },
    "/api/v1/items/{id}/children": {
      "get": {
        "tags": [
          "browse"
        ],
        "summary": "Seasons, episodes, albums or tracks under an item.",
        "operationId": "children",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemSummary"
                  }
                }
              }
            }
          },
          "404": {}
        }
      }
    },
    "/api/v1/libraries": {
      "get": {
        "tags": [
          "libraries"
        ],
        "summary": "Libraries the user can access.",
        "operationId": "list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LibraryDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "libraries"
        ],
        "summary": "Create a library (admin). Roots must exist and must not overlap other libraries.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLibraryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDto"
                }
              }
            }
          },
          "409": {},
          "422": {}
        }
      }
    },
    "/api/v1/libraries/{id}": {
      "get": {
        "tags": [
          "libraries"
        ],
        "summary": "One library.",
        "operationId": "get_one",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDto"
                }
              }
            }
          },
          "404": {}
        }
      },
      "delete": {
        "tags": [
          "libraries"
        ],
        "summary": "Delete a library and its items (admin).",
        "operationId": "remove",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {}
        }
      },
      "patch": {
        "tags": [
          "libraries"
        ],
        "summary": "Update a library (admin).",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLibraryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDto"
                }
              }
            }
          },
          "404": {}
        }
      }
    },
    "/api/v1/libraries/{id}/items": {
      "get": {
        "tags": [
          "browse"
        ],
        "summary": "Items of a library, paginated.",
        "operationId": "list",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "Item kind; defaults to the library's top-level items.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/MediaKind"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortField"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "unwatched",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1–200, default 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paginated_ItemSummary"
                }
              }
            }
          },
          "404": {}
        }
      }
    },
    "/api/v1/libraries/{id}/scan": {
      "post": {
        "tags": [
          "libraries"
        ],
        "summary": "Queue a library scan (admin).",
        "operationId": "scan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "404": {}
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "browse"
        ],
        "summary": "Title search grouped by kind, at most 10 per group.",
        "operationId": "search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchGroup"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/browse": {
      "get": {
        "tags": [
          "libraries"
        ],
        "summary": "List server directories for picking library roots (admin).",
        "operationId": "browse",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirListing"
                }
              }
            }
          },
          "403": {}
        }
      }
    },
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Server name, version and platform.",
        "operationId": "info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/system/setup": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Whether the first admin still has to be created.",
        "operationId": "setup_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        },
        "security": []
      },
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Create the first admin account. Only allowed while no users exist.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "409": {}
        },
        "security": []
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "All users (admin).",
        "operationId": "list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  }
                }
              }
            }
          },
          "403": {}
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Create a user (admin).",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "403": {},
          "409": {}
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "A user (admins, or the user themselves).",
        "operationId": "get_one",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "404": {}
        }
      },
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Delete a user (admin).",
        "operationId": "remove",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {},
          "403": {},
          "404": {}
        }
      },
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "Update a user; only admins may change `isAdmin`.",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "403": {},
          "404": {}
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness + database reachability.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {}
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ArtworkId": {
        "type": "integer",
        "format": "int64"
      },
      "ArtworkInfo": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "palette",
          "selected"
        ],
        "properties": {
          "blurhash": {
            "type": [
              "string",
              "null"
            ]
          },
          "hash": {
            "type": [
              "string",
              "null"
            ],
            "description": "Content hash once downloaded; pass as `?v=` for immutable caching."
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "$ref": "#/components/schemas/ArtworkId"
          },
          "kind": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selected": {
            "type": "boolean"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "CreateLibraryRequest": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "paths"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/LibraryKind"
          },
          "name": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "isAdmin": {
            "type": "boolean"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Credit": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "character": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "thumbUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Cursor": {
        "type": "string",
        "description": "Opaque pagination cursor. Its encoding is owned by the repository that issues it."
      },
      "DirEntry": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "DirListing": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DirEntry"
            }
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "`None` for the virtual top level (filesystem root list)."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Hub": {
        "type": "object",
        "required": [
          "key",
          "title",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemSummary"
            }
          },
          "key": {
            "type": "string",
            "description": "Stable identifier, e.g. `continueWatching` or `recentlyAdded.3`."
          },
          "libraryId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LibraryId"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ItemDetail": {
        "type": "object",
        "required": [
          "id",
          "libraryId",
          "kind",
          "title",
          "needsReview",
          "addedAt",
          "genres",
          "people",
          "artwork",
          "versions",
          "watch"
        ],
        "properties": {
          "addedAt": {
            "type": "integer",
            "format": "int64"
          },
          "artwork": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtworkInfo"
            }
          },
          "contentRating": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationMs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
