      "openWorldHint": false
    }
  },
  {
    "name": "create_optimized_versions",
    "description": "Create an optimized H.264 High + AAC stereo MP4 version ('universal_1080p' or 'universal_720p') for an item or library so remote and incompatible clients can direct play. Supports dry_run size and duration estimate.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "default": false,
          "description": "Return estimated output file size and duration without transcoding",
          "type": "boolean"
        },
        "item_id": {
          "description": "Media item ID to optimize",
          "type": "integer"
        },
        "library_id": {
          "description": "Optional library ID to optimize",
          "type": "integer"
        },
        "night_window_only": {
          "default": false,
          "description": "Queue optimization for the overnight idle window",
          "type": "boolean"
        },
        "profile": {
          "default": "universal_1080p",
          "description": "Optimization profile ('universal_1080p' or 'universal_720p')",
          "type": "string"
        }
      },
      "type": "object"
    },
    "annotations": {
      "title": "Create Optimized Versions",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "search_scenes",
