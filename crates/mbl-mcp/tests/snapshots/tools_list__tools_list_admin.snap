  {
    "name": "create_user",
    "description": "Create a new user account with specified credentials and optional parental controls/library restrictions. Supports dry_run preview.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "contentRatingCeiling": {
          "description": "Maximum allowed rating, e.g. 'PG-13', 'TV-14'",
          "type": "string"
        },
        "displayName": {
          "description": "Human-friendly display name",
          "type": "string"
        },
        "dryRun": {
          "description": "If true, simulates user creation and returns a plan without modifying the database",
          "type": "boolean"
        },
        "isAdmin": {
          "description": "Whether this user has full administrator privileges (default: false)",
          "type": "boolean"
        },
        "isManaged": {
          "description": "Whether this is a managed child profile (default: false)",
          "type": "boolean"
        },
        "libraryIds": {
          "description": "Specific library IDs the user is allowed to access (empty/null allows all libraries)",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "password": {
          "description": "User password (minimum 8 characters)",
          "type": "string"
        },
        "username": {
          "description": "Unique username (3-32 alphanumeric/underscore characters)",
          "type": "string"
        }
      },
      "required": [
        "username",
        "password"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Create User",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
