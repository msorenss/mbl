    }
  },
  {
    "name": "run_hw_selftest",
    "description": "Run the functional hardware acceleration self-test across candidate backends and update the cached capability matrix and transcode capacity. Supports dry_run preview.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "default": false,
