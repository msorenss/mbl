  {
    "name": "search_scenes",
    "description": "Semantic visual scene search across indexed movie and episode keyframes using Hailo NPU / CLIP multimodal embeddings (e.g. 'find the scene with a car chase in the snow').",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
