  {
    "name": "explain_session",
    "description": "Get detailed playback state and transcoding reasons for an active playback session.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "description": "Active playback session ID",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Explain Playback Session",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "preview_playback",
    "description": "Simulate playback decision for a media item under a given device profile (e.g. 'chrome', 'firefox', 'safari', 'edge') without starting a session.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "audio_stream_index": {
          "description": "Optional audio stream index",
          "type": "integer"
        },
        "item_id": {
          "description": "Media item ID",
          "type": "integer"
        },
        "max_bitrate": {
          "description": "Optional maximum streaming bitrate in bps",
          "type": "integer"
        },
        "part_id": {
          "description": "Optional specific media part ID",
          "type": "integer"
        },
        "profile": {
          "description": "Device profile name ('chrome', 'firefox', 'safari', 'edge') or full device profile object"
        },
        "subtitle_stream_index": {
          "description": "Optional subtitle stream index",
          "type": "integer"
        }
      },
      "required": [
        "item_id"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Preview Playback",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
